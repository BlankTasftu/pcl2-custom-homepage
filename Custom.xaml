<!-- ==================== 区块 4 / 4：懒人功能面板 ==================== -->
<local:MyCard Title="懒人功能面板" CanSwap="True" IsSwapped="True">
    <StackPanel Margin="25,40,23,15">
        <local:MyHint Margin="0,0,0,7" IsWarn="False" Text="为找不到文件夹的小白准备的打开文件夹功能" />
        <local:MyHint Margin="0,0,0,7" Text="MOD是.jar文件 材质和光影是.zip文件 不需要解压！" />
        <!-- ========== 文件夹按钮 ==========
             【改我 11】EventData 的写法是「命令|参数」：explorer 是 Windows 资源管理器，
             竖线后面是要打开的文件夹。竖线不能省，省了 PCL 会把整串当成程序路径去找。
             6 个路径都用 PCL 的「版本隔离文件夹」替换标记拼出来，所以换整合包、改版本名、
             开不开版本隔离都不用改这里：
               {version_indie}mods              {version_indie}resourcepacks
               {version_indie}shaderpacks       {version_indie}replay_recordings
               {version_indie}schematics        {version_indie}saves
             路径两头用 &quot; 包起来，避免路径里的空格导致打开失败（PCL 官方也建议这么做）。
             想换成别的文件夹，改竖线后面那一截即可。详见 docs/customize.md。 -->
        <!-- 这是第一行 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <local:MyButton Margin="0,0,10,0" Width="140" Height="35" HorizontalAlignment="Left" Padding="13,0,13,0"
                   Text="打开MOD文件夹" EventType="执行命令" EventData="explorer|&quot;{version_indie}mods&quot;" ToolTip="安装MOD时.jar文件应该放到这里" />
            <local:MyButton Margin="0,0,10,0" Width="140" Height="35" HorizontalAlignment="Left" Padding="13,0,13,0"
                   Text="打开材质文件夹" EventType="执行命令" EventData="explorer|&quot;{version_indie}resourcepacks&quot;" ToolTip="安装的材质包.zip .rar等压缩包要放到这里" />
            <local:MyButton Margin="0,0,10,0" Width="140" Height="35" HorizontalAlignment="Left" Padding="13,0,13,0"
                   Text="打开光影文件夹" EventType="执行命令" EventData="explorer|&quot;{version_indie}shaderpacks&quot;" ToolTip="安装的光影包.zip .rar等压缩包要放到这里" />
        </StackPanel>
        <!-- 这是第二行 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <local:MyButton Margin="0,0,10,0" Width="140" Height="35" HorizontalAlignment="Left" Padding="13,0,13,0" ColorType="Highlight"
                   Text="打开Replay文件夹" EventType="执行命令" EventData="explorer|&quot;{version_indie}replay_recordings&quot;" ToolTip="回放MOD的录像文件在这里记得发给狗腐竹" />
            <local:MyButton Margin="0,0,10,0" Width="140" Height="35" HorizontalAlignment="Left" Padding="13,0,13,0" ColorType="Red"
                   Text="打开蓝图文件夹" EventType="执行命令" EventData="explorer|&quot;{version_indie}schematics&quot;" ToolTip="装载的蓝图文件要放到这里" />
            <!-- 这一行原本漏了「|」分隔符，PCL 会把整串当成进程路径去找、点击必定失败；
                 v1.0.4 起统一改用替换标记写法。 -->
            <local:MyButton Margin="0,0,10,0" Width="140" Height="35" HorizontalAlignment="Left" Padding="13,0,13,0" ColorType="Highlight"
                   Text="打开地图文件夹" EventType="执行命令" EventData="explorer|&quot;{version_indie}saves&quot;" ToolTip="小地图的探索记录，换新端的时候要备份放到新端的这里哦！" />
        </StackPanel>
        <!-- 这是第三行 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <local:MyButton Margin="0,0,10,0" Width="140" Height="35" HorizontalAlignment="Left" Padding="13,0,13,0" ColorType="Red"
                   Text="下载TeamSpeak 3" EventType="下载文件" EventData="https://files.teamspeak-services.com/releases/client/3.6.2/TeamSpeak3-Client-win64-3.6.2.exe" ToolTip="点此下载安装包,要打开安装不是下载完了就行哦!" />
            <local:MyButton Margin="0,0,10,0" Width="140" Height="35" HorizontalAlignment="Left" Padding="13,0,13,0" ColorType="Red"
                   Text="下载TS3汉化" EventType="下载文件" EventData="https://dl.tmspk.wiki/https:/github.com/VigorousPro/TS3-Translation_zh-CN/releases/download/snapshot/Chinese_Translation_zh-CN.ts3_translation" ToolTip="点此下载汉化包,要打开安装不是下载完了就行哦!" />
            <local:MyButton Margin="0,0,10,0" Width="140" Height="35" HorizontalAlignment="Left" Padding="13,0,13,0" ColorType="Highlight"
                   Text="刷新主页" EventType="刷新主页" ToolTip="战术调试" />
        </StackPanel>
    </StackPanel>
</local:MyCard>
